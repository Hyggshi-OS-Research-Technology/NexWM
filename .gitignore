# Build artifacts
bin/
*.o
*.d
*.a
*.so
# hde-core/notifications/notifications.o used to be committed by mistake: a build object is never source.
# `make check-tree` fails when a tracked file is one of these again (and says the `git rm --cached` line to fix it).
hde-core/**/*.o
hde-core/**/*.a
hde-core/**/*.so
# (no entry for "nexwm": nexwm/ is the source tree of HDE's own window manager and is tracked; the built program
#  goes to $(BUILD)/nexwm — the "nexwm" entry that used to be here hid the whole source directory)
build/
bin
hde-cmd/hde-cmd

# Debug/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
*.log
# core dumps (core, core.<pid>) — do NOT use "core.*": it would hide hde-core/**/core.[ch]
core
core.[0-9]*
vgcore.*

# Temporary files
*.tmp

# the byte-code of the test helpers that are python (tests/xtool.py, tests/fake-mpv.py)
__pycache__/
*.pyc
