# Build artifacts
bin/
*.o
*.d
*.a
*.so
# (no entry for "nexwm": nexwm/ is the source tree of HDE's own window manager and is tracked; the built program
#  goes to $(BUILD)/nexwm — the "nexwm" entry that used to be here hid the whole source directory)
build/
bin

# Debug/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
*.log
# core dumps (core, core.<pid>) — do NOT use "core.*": it would hide hde-core/**/core.[ch]
core
core.[0-9]*
vgcore.*

# Temporary files
*.tmp

# the byte-code of the test helpers that are python (tests/xtool.py, tests/fake-mpv.py)
__pycache__/
*.pyc
