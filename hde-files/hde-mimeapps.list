# Default applications of HDE sessions (XDG_CURRENT_DESKTOP=HDE): folders open in Hyggshi Files, pictures in Hyggshi
# Media — and so do the music and the video (hde-media is both: the same program opens the picture window or the player
# window for what it is given).
# A choice made by the user (~/.config/mimeapps.list, "Open With" > "Always use it") comes first.
[Default Applications]
inode/directory=hde-files.desktop
image/png=hde-media.desktop
image/jpeg=hde-media.desktop
image/gif=hde-media.desktop
image/bmp=hde-media.desktop
image/webp=hde-media.desktop
image/tiff=hde-media.desktop
image/avif=hde-media.desktop
image/heic=hde-media.desktop
image/heif=hde-media.desktop
image/jxl=hde-media.desktop
image/vnd.microsoft.icon=hde-media.desktop
image/x-portable-pixmap=hde-media.desktop
image/x-xpixmap=hde-media.desktop
audio/mpeg=hde-media.desktop
audio/ogg=hde-media.desktop
audio/opus=hde-media.desktop
audio/flac=hde-media.desktop
audio/x-flac=hde-media.desktop
audio/wav=hde-media.desktop
audio/x-wav=hde-media.desktop
audio/aac=hde-media.desktop
audio/mp4=hde-media.desktop
audio/x-m4a=hde-media.desktop
audio/x-vorbis+ogg=hde-media.desktop
video/mp4=hde-media.desktop
video/x-matroska=hde-media.desktop
video/webm=hde-media.desktop
video/ogg=hde-media.desktop
video/quicktime=hde-media.desktop
video/x-msvideo=hde-media.desktop
video/mpeg=hde-media.desktop
video/x-flv=hde-media.desktop
video/3gpp=hde-media.desktop
