[Desktop Entry]
Type=Application
Name=Hyggshi Store
GenericName=Software & App Store
Comment=Find, install, update and remove the software of Hyggshi OS
Exec=@PREFIX@/bin/hde-store
Icon=system-software-install
Terminal=false
Categories=GTK;System;PackageManager;
Keywords=store;software;applications;install;remove;update;packages;deb;flatpak;
StartupNotify=true
