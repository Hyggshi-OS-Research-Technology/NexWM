#!/bin/sh
# hde-start — entry point of the HDE session (called by the display manager / startx).
#   hde-start             the X11 session ("HDE" on the login screen)
#   hde-start --wayland   the Wayland session ("HDE (Wayland)"): the labwc compositor with HDE inside
# Log: ~/.cache/hde/session.log  (check this file if the session does not come up)

LOGDIR="${XDG_CACHE_HOME:-$HOME/.cache}/hde"
mkdir -p "$LOGDIR" 2>/dev/null
if [ -w "$LOGDIR" ]; then
    [ -f "$LOGDIR/session.log" ] && mv -f "$LOGDIR/session.log" "$LOGDIR/session.log.old" 2>/dev/null
    exec >"$LOGDIR/session.log" 2>&1
fi

echo "hde-start: $(date)  DISPLAY=${DISPLAY:-unset} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset} ${1:-}"

# How to install a package here: Debian's apt, Fedora's dnf, openSUSE's zypper, Arch's pacman (the package names used
# in this script are the same everywhere).
install_hint() {
    if command -v dnf >/dev/null 2>&1; then echo "sudo dnf install $1"
    elif command -v apt >/dev/null 2>&1; then echo "sudo apt install $1"
    elif command -v zypper >/dev/null 2>&1; then echo "sudo zypper install $1"
    elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S $1"
    else echo "install $1"; fi
}

# Start the programs of this installation, not a stale copy in /usr/local/bin: the display manager's PATH is not
# always complete, and a source build in /usr/local must not win over an APT package in /usr (or the other way
# around). The directory of hde-start is the one the login manager actually selected.
HERE="$(dirname "$(readlink -f "$0")")"
case ":$PATH:" in *":$HERE:"*) ;; *) PATH="$HERE:$PATH" ;; esac
export PATH
# Libraries are found through the normal system path (or the rpath with which the programs were linked). Do not mix
# a user's ~/.local libraries into a packaged session.

# --wm NAME: the window manager this session must use (the "NexWM" entry on the login screen is HDE with
# `hde-start --wm nexwm`). It is the same as exporting HDE_WM; Settings can still change it while the session runs.
WM_ARG=""
if [ "${1:-}" = "--wm" ] && [ -n "${2:-}" ]; then
    HDE_WM="$2"
    WM_ARG="$2"
    export HDE_WM
    shift 2
fi

if [ "${1:-}" = "--wayland" ]; then
    # ---- the Wayland session: hde-session writes the compositor's configuration and starts it, and the compositor
    # starts the rest of HDE inside itself. "HDE (Wayland)" is labwc; "NexWM (Wayland)" is
    # `hde-start --wm nexwm --wayland` and asks for HDE's own compositor (hde-session uses labwc on the machines where
    # this nexwm has no compositor yet, so that entry never ends at a black screen).
    HERE="$(dirname "$(readlink -f "$0")")"
    if [ -x "$HERE/hde-session" ]; then SESSION="$HERE/hde-session"
    else SESSION="$(command -v hde-session)"; fi
    if [ -z "$SESSION" ]; then echo "hde-start: hde-session not found (HERE=$HERE PATH=$PATH)"; exit 1; fi
    # DISPLAY alone does not mean an Xorg server was started for this session. A session picked from
    # /usr/share/wayland-sessions ("HDE (Wayland)") is started by the login manager with XDG_SESSION_TYPE=wayland, and
    # a DISPLAY that is set then is a leftover (/etc/environment, ~/.profile, the environment of a previous X11
    # session): treating it as "Xorg is already running" sent the chosen Wayland session to the X11 path.
    # Only a live WAYLAND_DISPLAY socket (hde-start --wayland run from inside another compositor) keeps the old rule.
    X_ALREADY=0
    if [ -n "${DISPLAY:-}" ] && [ -z "${HDE_TEST_OUT:-}" ] && [ -z "${WLR_BACKENDS:-}" ]; then
        X_ALREADY=1
        if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
            WL_LIVE=0
            if [ -n "${WAYLAND_DISPLAY:-}" ]; then
                case "$WAYLAND_DISPLAY" in
                    /*) [ -S "$WAYLAND_DISPLAY" ] && WL_LIVE=1 ;;
                    *)  [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ] && WL_LIVE=1 ;;
                esac
            fi
            if [ "$WL_LIVE" = 0 ]; then
                echo "hde-start: XDG_SESSION_TYPE=wayland: ignoring the leftover DISPLAY=$DISPLAY, starting the Wayland session"
                X_ALREADY=0
            fi
        fi
    fi
    if [ "$X_ALREADY" = 1 ]; then
        # When SDDM started an Xorg server for this session (e.g. xsessions/hde-wayland.desktop on machines without
        # labwc), Xorg already holds DRM master on this VT; run the HDE session directly on DISPLAY.
        echo "hde-start: DISPLAY=$DISPLAY is already active; starting HDE session on DISPLAY"
        shift
    else
        if [ "${WM_ARG:-}" = "nexwm" ]; then
            if ! command -v nexwm >/dev/null 2>&1 && [ ! -x "$HERE/nexwm" ]; then
                echo "hde-start: the NexWM (Wayland) session needs NexWM: $(install_hint nexwm)"
                exit 1
            fi
            set -- --wayland --wm nexwm
            echo "hde-start: running $SESSION --wayland --wm nexwm (NexWM, HDE's own compositor)"
        else
            if ! command -v labwc >/dev/null 2>&1 && ! command -v nexwm >/dev/null 2>&1 && [ ! -x "$HERE/nexwm" ]; then
                echo "hde-start: the HDE (Wayland) session needs labwc or nexwm: $(install_hint labwc)"
                exit 1
            fi
            set -- --wayland
            echo "hde-start: running $SESSION --wayland"
        fi
        if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR:-}" ]; then
            XDG_RUNTIME_DIR="/run/user/$(id -u)"
            if [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
                XDG_RUNTIME_DIR="/tmp/hde-runtime-$(id -u)"
                mkdir -p -m 700 "$XDG_RUNTIME_DIR" 2>/dev/null
                chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
            fi
            export XDG_RUNTIME_DIR
        fi
        export WLR_NO_HARDWARE_CURSORS="${WLR_NO_HARDWARE_CURSORS:-1}"
        export WLR_RENDERER_ALLOW_SOFTWARE="${WLR_RENDERER_ALLOW_SOFTWARE:-1}"
        export XDG_CURRENT_DESKTOP=HDE XDG_SESSION_DESKTOP=HDE DESKTOP_SESSION=hde-wayland XDG_SESSION_TYPE=wayland
        unset DISPLAY WAYLAND_DISPLAY GDK_BACKEND GDK_CORE_DEVICE_EVENTS
        if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
            export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
        fi
        if [ -n "${HDE_TEST_OUT:-}" ] || [ -n "${WLR_BACKENDS:-}" ] || command -v labwc >/dev/null 2>&1; then
            if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
                exec dbus-run-session -- "$SESSION" "$@"
            fi
            exec "$SESSION" "$@"
        fi
        if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
            dbus-run-session -- "$SESSION" "$@"
        else
            "$SESSION" "$@"
        fi
        rc=$?
        [ "$rc" -eq 0 ] && exit 0
        echo "hde-start: Wayland compositor exited with status $rc; attempting X11 session fallback"
        if command -v xinit >/dev/null 2>&1; then
            VT_ARG=""
            [ -n "${XDG_VTNR:-}" ] && VT_ARG="vt${XDG_VTNR}"
            exec xinit "$SESSION" -- :1 $VT_ARG -keeptty -noreset
        fi
        exit "$rc"
    fi
fi

export XDG_CURRENT_DESKTOP=HDE
export XDG_SESSION_DESKTOP=HDE
export DESKTOP_SESSION=hde
# Window manager selected in Settings; auto uses hde-session fallback list.
if [ -z "${HDE_WM:-}" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hde/settings.ini" ]; then
    HDE_WM="$(sed -n 's/^wm=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/hde/settings.ini" | head -n1)"
    [ -n "$HDE_WM" ] && export HDE_WM
fi
export GDK_BACKEND=x11
# Nested in a Wayland host (Xephyr): XInput2 gets no pointer input -> use core events.
if [ -z "${HDE_XI2:-}" ] && { [ -n "${HDE_CORE_EVENTS:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
    export GDK_CORE_DEVICE_EVENTS=1
fi

# Prefer the hde-session next to this file (the copy that was just installed), then search PATH
HERE="$(dirname "$(readlink -f "$0")")"
if [ -x "$HERE/hde-session" ]; then SESSION="$HERE/hde-session"
elif command -v hde-session >/dev/null 2>&1; then SESSION="$(command -v hde-session)"
else
    echo "hde-start: hde-session not found (HERE=$HERE PATH=$PATH)"
    exit 1
fi

if [ -z "${DISPLAY:-}" ]; then
    echo "hde-start: DISPLAY is not set — this is the X11 session (pick 'HDE' on the login screen or use startx; on Wayland pick 'HDE (Wayland)')."
    exit 1
fi

# Basic graphics setup: load ~/.Xresources, keymap... if present
[ -f "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"

# Root cursor: without one, X shows an "X" or nothing at all, which looks like the mouse is not working.
command -v xsetroot >/dev/null 2>&1 && xsetroot -cursor_name left_ptr

if [ -n "$WM_ARG" ]; then
    set -- --wm "$WM_ARG"          # hde-session runs this window manager, whatever Settings has chosen
else
    set --
fi
echo "hde-start: running $SESSION $*"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$SESSION" "$@"
fi
exec "$SESSION" "$@"
