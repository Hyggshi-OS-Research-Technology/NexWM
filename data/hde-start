#!/bin/sh
# hde-start — điểm vào của phiên HDE (display manager / startx gọi file này).
# Log: ~/.cache/hde/session.log  (xem file này nếu phiên không lên)

LOGDIR="${XDG_CACHE_HOME:-$HOME/.cache}/hde"
mkdir -p "$LOGDIR" 2>/dev/null
if [ -w "$LOGDIR" ]; then
    [ -f "$LOGDIR/session.log" ] && mv -f "$LOGDIR/session.log" "$LOGDIR/session.log.old" 2>/dev/null
    exec >"$LOGDIR/session.log" 2>&1
fi

echo "hde-start: $(date)  DISPLAY=${DISPLAY:-unset} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset}"

export XDG_CURRENT_DESKTOP=HDE
export XDG_SESSION_DESKTOP=HDE
export DESKTOP_SESSION=hde
# Window manager selected in Settings; auto uses hde-session fallback list.
if [ -z "${HDE_WM:-}" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hde/settings.ini" ]; then
    HDE_WM="$(sed -n 's/^wm=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/hde/settings.ini" | head -n1)"
    [ -n "$HDE_WM" ] && export HDE_WM
fi
export GDK_BACKEND=x11
# Lồng trong host Wayland (Xephyr): XInput2 không nhận chuột -> dùng core events.
if [ -z "${HDE_XI2:-}" ] && { [ -n "${HDE_CORE_EVENTS:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
    export GDK_CORE_DEVICE_EVENTS=1
fi

# PATH của display manager đôi khi không có /usr/local/bin
case ":$PATH:" in *:/usr/local/bin:*) ;; *) PATH="$PATH:/usr/local/bin" ;; esac
export PATH

# Ưu tiên hde-session nằm cạnh file này (đúng bản vừa cài), rồi mới tìm trong PATH
HERE="$(dirname "$(readlink -f "$0")")"
if [ -x "$HERE/hde-session" ]; then SESSION="$HERE/hde-session"
elif command -v hde-session >/dev/null 2>&1; then SESSION="$(command -v hde-session)"
else
    echo "hde-start: không tìm thấy hde-session (HERE=$HERE PATH=$PATH)"
    exit 1
fi

if [ -z "${DISPLAY:-}" ]; then
    echo "hde-start: DISPLAY chưa được set — phiên HDE cần X11 (chọn phiên 'HDE' trên màn hình đăng nhập, không phải Wayland, hoặc dùng startx)."
    exit 1
fi

# Nền tảng đồ hoạ cơ bản: nạp ~/.Xresources, keymap... nếu có
[ -f "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"

# Con trỏ chuột gốc: không có thì X hiện dấu "X"/không hiện gì, trông như chuột không hoạt động.
command -v xsetroot >/dev/null 2>&1 && xsetroot -cursor_name left_ptr

echo "hde-start: chạy $SESSION"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$SESSION"
fi
exec "$SESSION"
