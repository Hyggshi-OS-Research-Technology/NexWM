[Desktop Entry]
Type=Application
Name=Hyggshi Calendar
GenericName=Calendar & Event Planner
Comment=View monthly and yearly calendars, holidays, and manage recurring events and schedules
Exec=@PREFIX@/bin/hde-calendar
