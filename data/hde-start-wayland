#!/bin/sh
# hde-start-wayland — single-command entry point for the HDE (Wayland) session.
# Debian and Ubuntu's /etc/X11/Xsession.d/20x11-common_process-args requires Exec= in /usr/share/xsessions/*.desktop
# to be a single executable path without arguments (otherwise `which "$1"` fails and falls back to x-session-manager).
HERE="$(dirname "$(readlink -f "$0")")"
if [ -x "$HERE/hde-start" ]; then
    exec "$HERE/hde-start" --wayland "$@"
fi
exec hde-start --wayland "$@"
