#!/bin/sh
# start-nexde — Session launcher for Nex Desktop Environment

# Display managers run this with a restricted PATH that usually excludes
# /usr/local/bin, so call the installed binaries by absolute path.
BINDIR=/usr/local/bin

# 1. Restore wallpaper (or solid color background fallback)
"$BINDIR/nex-wallpaper" --restore 2>/dev/null || "$BINDIR/nex-wallpaper" --color 0x1a1a2e &

# 2. Start Desktop Icon Manager
"$BINDIR/nex-desktop" &

# 3. Start NexPanel (Status Bar + Taskbar + Workspace Pager)
"$BINDIR/nex-panel" &

# 4. Show welcome notification toast
"$BINDIR/nex-notify" "NexDE" "Welcome to Nex Desktop Environment" 3000 &

# 5. Execute core Window Manager (keeps session alive)
exec "$BINDIR/nexwm"
