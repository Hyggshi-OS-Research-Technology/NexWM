#!/bin/bash
# test-tray — thử system tray của hde-panel bằng app SNI thật trong Xvfb + D-Bus riêng.
#
#   ./scripts/test-tray            # chế độ server: hde-panel giữ StatusNotifierWatcher
#   ./scripts/test-tray xfce       # đã có xfce4-panel làm watcher -> hde-panel làm client,
#                                  # rồi xfce4-panel thoát để hde-panel tự lên thay
#
# Cần: xvfb, xdotool, imagemagick, dbus-x11, python3-gi, gir1.2-ayatanaappindicator3-0.1, openbox
#      (chế độ xfce: thêm xfce4-panel xfconf). Ảnh chụp lưu ở /tmp/hde-tray-*.png
set -u
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
MODE="${1:-server}"

if [ -z "${HDE_TEST_INNER:-}" ]; then
    HDE_TEST_INNER=1 exec dbus-run-session -- "$0" "$MODE"
fi

export DISPLAY=:99 GDK_BACKEND=x11 NO_AT_BRIDGE=1
PIDS=""
trap 'kill $PIDS 2>/dev/null' EXIT
run() { "$@" >/dev/null 2>&1 & PIDS="$PIDS $!"; }
shot() { import -window root -crop 420x34+860+686 +repage "/tmp/hde-tray-$1.png"; }
items() { gdbus call --session --dest org.kde.StatusNotifierWatcher --object-path /StatusNotifierWatcher \
          --method org.freedesktop.DBus.Properties.Get org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>&1; }
ok() { echo "  OK   $*"; }
bad() { echo "  FAIL $*"; FAILED=1; }
FAILED=0

run Xvfb :99 -screen 0 1280x720x24; sleep 1
run openbox; sleep 0.5

if [ "$MODE" = xfce ]; then
    run xfce4-panel --disable-wm-check; sleep 4
fi

python3 "$ROOT/scripts/sni-test-app.py" >/dev/null 2>&1 & APP=$!; sleep 2
"$ROOT/build/hde-panel" 2>/tmp/hde-tray-panel.log & PANEL=$!; PIDS="$PIDS $PANEL"; sleep 3
shot 1-app-alive

echo "[1] app đăng ký"
items | grep -q hde_test_app && ok "item có trên watcher" || bad "item không có trên watcher"
if [ "$MODE" = xfce ]; then
    grep -q "client" /tmp/hde-tray-panel.log && ok "hde-panel chuyển sang chế độ client" || bad "không vào chế độ client"
fi

echo "[2] app thoát"
kill $APP; sleep 2; shot 2-app-exited
items | grep -q hde_test_app && bad "item vẫn còn" || ok "item đã bị gỡ"

echo "[3] app mới"
python3 "$ROOT/scripts/sni-test-app.py" >/dev/null 2>&1 & APP=$!; sleep 3; shot 3-new-app
items | grep -q hde_test_app && ok "item có lại" || bad "item không có lại"

if [ "$MODE" = xfce ]; then
    echo "[4] xfce4-panel thoát -> hde-panel làm watcher"
    pkill xfce4-panel; sleep 3; shot 4-takeover
    owner=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.GetNameOwner org.kde.StatusNotifierWatcher | tr -d "(',)")
    pid=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
          --method org.freedesktop.DBus.GetConnectionUnixProcessID "$owner" | sed -n 's/.*uint32 \([0-9]*\).*/\1/p')
    [ "$pid" = "$PANEL" ] && ok "hde-panel đã giữ watcher" || bad "chủ watcher là pid $pid, không phải hde-panel ($PANEL)"
    items | grep -q hde_test_app && ok "item vẫn còn" || bad "mất item sau takeover"
fi

kill $APP 2>/dev/null; sleep 2
kill -0 "$PANEL" 2>/dev/null && ok "hde-panel không crash" || bad "hde-panel đã chết"
echo "Ảnh chụp: /tmp/hde-tray-*.png"
exit $FAILED
