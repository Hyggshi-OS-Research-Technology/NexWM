#!/bin/bash
# test-tray — tests the hde-panel system tray with a real SNI app in Xvfb + a private D-Bus.
#
#   ./scripts/test-tray            # server mode: hde-panel owns StatusNotifierWatcher
#   ./scripts/test-tray xfce       # xfce4-panel is already the watcher -> hde-panel acts as a client,
#                                  # then xfce4-panel quits and hde-panel takes over by itself
#
# Needs: xvfb, xdotool, imagemagick, dbus-x11, python3-gi, gir1.2-ayatanaappindicator3-0.1, openbox
#        (xfce mode: also xfce4-panel xfconf). Screenshots are saved to /tmp/hde-tray-*.png
set -u
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
MODE="${1:-server}"

if [ -z "${HDE_TEST_INNER:-}" ]; then
    HDE_TEST_INNER=1 exec dbus-run-session -- "$0" "$MODE"
fi

export DISPLAY=:99 GDK_BACKEND=x11 NO_AT_BRIDGE=1
PIDS=""
trap 'kill $PIDS 2>/dev/null' EXIT
run() { "$@" >/dev/null 2>&1 & PIDS="$PIDS $!"; }
shot() { import -window root -crop 420x34+860+686 +repage "/tmp/hde-tray-$1.png"; }
items() { gdbus call --session --dest org.kde.StatusNotifierWatcher --object-path /StatusNotifierWatcher \
          --method org.freedesktop.DBus.Properties.Get org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>&1; }
ok() { echo "  OK   $*"; }
bad() { echo "  FAIL $*"; FAILED=1; }
FAILED=0

run Xvfb :99 -screen 0 1280x720x24; sleep 1
run openbox; sleep 0.5

if [ "$MODE" = xfce ]; then
    run xfce4-panel --disable-wm-check; sleep 4
fi

python3 "$ROOT/scripts/sni-test-app.py" >/dev/null 2>&1 & APP=$!; sleep 2
"$ROOT/build/hde-panel" 2>/tmp/hde-tray-panel.log & PANEL=$!; PIDS="$PIDS $PANEL"; sleep 3
shot 1-app-alive

echo "[1] app registers"
items | grep -q hde_test_app && ok "item is on the watcher" || bad "item is not on the watcher"
if [ "$MODE" = xfce ]; then
    grep -q "client" /tmp/hde-tray-panel.log && ok "hde-panel switched to client mode" || bad "did not switch to client mode"
fi

echo "[2] app quits"
kill $APP; sleep 2; shot 2-app-exited
items | grep -q hde_test_app && bad "item is still there" || ok "item was removed"

echo "[3] new app"
python3 "$ROOT/scripts/sni-test-app.py" >/dev/null 2>&1 & APP=$!; sleep 3; shot 3-new-app
items | grep -q hde_test_app && ok "item is back" || bad "item did not come back"

if [ "$MODE" = xfce ]; then
    echo "[4] xfce4-panel quits -> hde-panel becomes the watcher"
    pkill xfce4-panel; sleep 3; shot 4-takeover
    owner=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.GetNameOwner org.kde.StatusNotifierWatcher | tr -d "(',)")
    pid=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
          --method org.freedesktop.DBus.GetConnectionUnixProcessID "$owner" | sed -n 's/.*uint32 \([0-9]*\).*/\1/p')
    [ "$pid" = "$PANEL" ] && ok "hde-panel took over the watcher" || bad "watcher owner is pid $pid, not hde-panel ($PANEL)"
    items | grep -q hde_test_app && ok "item is still there" || bad "item lost after takeover"
fi

kill $APP 2>/dev/null; sleep 2
kill -0 "$PANEL" 2>/dev/null && ok "hde-panel did not crash" || bad "hde-panel died"
echo "Screenshots: /tmp/hde-tray-*.png"
exit $FAILED
