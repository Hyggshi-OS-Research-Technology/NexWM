```sh
#!/bin/sh

# test-nexde — Launch NexDE inside a Xephyr window
#
# Usage:
#   ./scripts/test-nexde
#   ./scripts/test-nexde 1920x1080
#   ./scripts/test-nexde 1280x720 :2
#
# Requirements:
#   - Xephyr
#   - xdpyinfo
#   - NexDE binaries built in bin/
#
# Components:
#   nexwm
#   nex-wallpaper
#   nex-desktop
#   nex-panel
#   nex-notify

set -eu

# ─────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────

SCREEN="${1:-1280x720}"
DISPLAY_NUM="${2:-:1}"

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
BINDIR="$ROOT_DIR/build"

XEphyr_PID=""
CHILD_PIDS=""
CLEANED_UP=0

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────

info()
{
    printf '%s\n' "[NexDE] $*"
}

error()
{
    printf '%s\n' "[NexDE] Error: $*" >&2
}

# ─────────────────────────────────────────────────────────────
# Cleanup
# ─────────────────────────────────────────────────────────────

cleanup()
{
    # Prevent cleanup from running twice.
    if [ "$CLEANED_UP" -eq 1 ]; then
        return
    fi

    CLEANED_UP=1

    echo ""
    info "Stopping NexDE..."

    # Stop NexDE components.
    if [ -n "$CHILD_PIDS" ]; then
        for pid in $CHILD_PIDS; do
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
            fi
        done
    fi

    # Give applications a moment to terminate normally.
    sleep 0.2

    # Force remaining components if necessary.
    if [ -n "$CHILD_PIDS" ]; then
        for pid in $CHILD_PIDS; do
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null || true
            fi
        done
    fi

    # Stop Xephyr.
    if [ -n "$XEphyr_PID" ]; then
        if kill -0 "$XEphyr_PID" 2>/dev/null; then
            kill "$XEphyr_PID" 2>/dev/null || true
        fi

        sleep 0.2

        if kill -0 "$XEphyr_PID" 2>/dev/null; then
            kill -KILL "$XEphyr_PID" 2>/dev/null || true
        fi
    fi

    # Reap child processes.
    if [ -n "$CHILD_PIDS" ]; then
        for pid in $CHILD_PIDS; do
            wait "$pid" 2>/dev/null || true
        done
    fi

    if [ -n "$XEphyr_PID" ]; then
        wait "$XEphyr_PID" 2>/dev/null || true
    fi

    info "NexDE test session stopped."
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─────────────────────────────────────────────────────────────
# Sanity checks
# ─────────────────────────────────────────────────────────────

if ! command -v Xephyr >/dev/null 2>&1; then
    error "Xephyr not found."
    echo ""
    echo "Install with:"
    echo "  sudo apt install xserver-xephyr"
    exit 1
fi

if ! command -v xdpyinfo >/dev/null 2>&1; then
    error "xdpyinfo not found."
    echo ""
    echo "Install with:"
    echo "  sudo apt install x11-utils"
    exit 1
fi

if [ ! -d "$BINDIR" ]; then
    error "bin directory not found:"
    echo "  $BINDIR"
    echo ""
    echo "Run 'make' first."
    exit 1
fi

# ─────────────────────────────────────────────────────────────
# Verify binaries
# ─────────────────────────────────────────────────────────────

REQUIRED_COMPONENTS="
nexwm
nex-wallpaper
nex-desktop
nex-panel
nex-notify
"

for component in $REQUIRED_COMPONENTS; do
    if [ ! -x "$BINDIR/$component" ]; then
        error "bin/$component not found or not executable."
        echo ""
        echo "Run 'make' first."
        exit 1
    fi
done

# ─────────────────────────────────────────────────────────────
# Check whether display is already in use
# ─────────────────────────────────────────────────────────────

if xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then
    error "Display $DISPLAY_NUM is already running."
    echo ""
    echo "Try another display:"
    echo "  ./scripts/test-nexde 1280x720 :2"
    exit 1
fi

# ─────────────────────────────────────────────────────────────
# Start Xephyr
# ─────────────────────────────────────────────────────────────

info "Starting Xephyr on $DISPLAY_NUM at $SCREEN..."

Xephyr \
    "$DISPLAY_NUM" \
    -ac \
    -br \
    -noreset \
    -screen "$SCREEN" &

XEphyr_PID=$!

info "Xephyr PID: $XEphyr_PID"

# ─────────────────────────────────────────────────────────────
# Wait for X server
# ─────────────────────────────────────────────────────────────

info "Waiting for X server..."

X_READY=0

i=0

while [ "$i" -lt 50 ]; do
    if ! kill -0 "$XEphyr_PID" 2>/dev/null; then
        error "Xephyr terminated unexpectedly."
        exit 1
    fi

    if xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then
        X_READY=1
        break
    fi

    sleep 0.1
    i=$((i + 1))
done

if [ "$X_READY" -ne 1 ]; then
    error "Xephyr failed to start on $DISPLAY_NUM."
    exit 1
fi

info "X server is ready."

# ─────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────

export DISPLAY="$DISPLAY_NUM"
export PATH="$BINDIR:$PATH"
export NEXDE_BINDIR="$BINDIR"

# Optional XDG environment for the test session.
export XDG_CURRENT_DESKTOP="NexDE"
export XDG_SESSION_DESKTOP="NexDE"

info "X11 display      : $DISPLAY"
info "Screen           : $SCREEN"
info "NexDE binaries   : $BINDIR"
info "Desktop          : $XDG_CURRENT_DESKTOP"

# ─────────────────────────────────────────────────────────────
# Start wallpaper
# ─────────────────────────────────────────────────────────────

info "Starting wallpaper..."

"$BINDIR/nex-wallpaper" \
    --color 0x1a1a2e &

CHILD_PIDS="$CHILD_PIDS $!"

sleep 0.1

# ─────────────────────────────────────────────────────────────
# Start desktop
# ─────────────────────────────────────────────────────────────

info "Starting desktop..."

"$BINDIR/nex-desktop" &

CHILD_PIDS="$CHILD_PIDS $!"

sleep 0.1

# ─────────────────────────────────────────────────────────────
# Start panel
# ─────────────────────────────────────────────────────────────

info "Starting panel..."

"$BINDIR/nex-panel" &

CHILD_PIDS="$CHILD_PIDS $!"

sleep 0.1

# ─────────────────────────────────────────────────────────────
# Start notification
# ─────────────────────────────────────────────────────────────

info "Starting welcome notification..."

"$BINDIR/nex-notify" \
    "NexDE" \
    "Test session ready" \
    2500 &

CHILD_PIDS="$CHILD_PIDS $!"

sleep 0.5

# ─────────────────────────────────────────────────────────────
# Test session information
# ─────────────────────────────────────────────────────────────

echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║                  NexDE TEST SESSION                     ║"
echo "╠══════════════════════════════════════════════════════════╣"
printf "║ Display : %-44s ║\n" "$DISPLAY"
printf "║ Screen  : %-44s ║\n" "$SCREEN"
printf "║ WM      : %-44s ║\n" "NexWM"
echo "╠══════════════════════════════════════════════════════════╣"
echo "║ Components                                             ║"
echo "║   • nex-wallpaper                                      ║"
echo "║   • nex-desktop                                        ║"
echo "║   • nex-panel                                          ║"
echo "║   • nex-notify                                         ║"
echo "║   • nexwm                                              ║"
echo "╠══════════════════════════════════════════════════════════╣"
echo "║ Close NexWM or press Ctrl+C to quit.                  ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""

# ─────────────────────────────────────────────────────────────
# Start NexWM
# ─────────────────────────────────────────────────────────────

info "Starting NexWM..."

"$BINDIR/nexwm" &

NEXWM_PID=$!
CHILD_PIDS="$CHILD_PIDS $NEXWM_PID"

# ─────────────────────────────────────────────────────────────
# Wait for NexWM
# ─────────────────────────────────────────────────────────────

wait "$NEXWM_PID" 2>/dev/null || true

info "NexWM exited."

# Cleanup is automatically executed by EXIT trap.
exit 0
```

### Run

```bash
chmod +x scripts/test-nexde
./scripts/test-nexde
```

Or:

```bash
./scripts/test-nexde 1920x1080
```

Another display:

```bash
./scripts/test-nexde 1280x720 :2
```

This version deliberately avoids `pkill -P $$`, so it **never touches NexDE processes running outside the test session by mistake**. When `nexwm` exits or you press `Ctrl+C`, the script stops the components it started itself and then closes Xephyr.
