#!/bin/sh

# test-nexde — Launch NexDE inside a Xephyr window
#
# Usage:
#   ./scripts/test-nexde
#   ./scripts/test-nexde 1920x1080
#   ./scripts/test-nexde 1280x720 :2

set -eu

SCREEN="${1:-1280x720}"
DISPLAY_NUM="${2:-:1}"

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
BINDIR="$ROOT_DIR/bin"

# ── Sanity checks ─────────────────────────────────────────────

if ! command -v Xephyr >/dev/null 2>&1; then
    echo "Error: Xephyr not found."
    echo "Install with:"
    echo "  sudo apt install xserver-xephyr"
    exit 1
fi

if [ ! -x "$BINDIR/nexwm" ]; then
    echo "Error: bin/nexwm not found."
    echo "Run 'make' first."
    exit 1
fi

for component in \
    nex-wallpaper \
    nex-desktop \
    nex-panel \
    nex-notify
do
    if [ ! -x "$BINDIR/$component" ]; then
        echo "Error: bin/$component not found."
        exit 1
    fi
done

# ── Cleanup ───────────────────────────────────────────────────

XEphyr_PID=""

cleanup() {
    echo ""
    echo "Stopping NexDE..."

    if [ -n "$XEphyr_PID" ]; then
        kill "$XEphyr_PID" 2>/dev/null || true
    fi

    # Kill components started by this script
    pkill -P $$ 2>/dev/null || true
}

trap cleanup EXIT INT TERM

# ── Start Xephyr ──────────────────────────────────────────────

echo "Starting Xephyr on $DISPLAY_NUM at $SCREEN..."

Xephyr "$DISPLAY_NUM" \
    -ac \
    -br \
    -noreset \
    -screen "$SCREEN" &

XEphyr_PID=$!

# Give X server time to start
sleep 1

# Verify display
if ! xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then
    echo "Error: Xephyr failed to start on $DISPLAY_NUM."
    exit 1
fi

# ── Environment ───────────────────────────────────────────────

export DISPLAY="$DISPLAY_NUM"
export PATH="$BINDIR:$PATH"

echo "X11 display: $DISPLAY"
echo "NexDE binaries: $BINDIR"

# ── Start desktop components ──────────────────────────────────

echo "Starting wallpaper..."
"$BINDIR/nex-wallpaper" \
    --color 0x1a1a2e &

echo "Starting desktop..."
"$BINDIR/nex-desktop" &

echo "Starting panel..."
"$BINDIR/nex-panel" &

echo "Starting notification daemon..."
"$BINDIR/nex-notify" &

sleep 0.5

# ── Start NexWM ───────────────────────────────────────────────

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║              NexDE TEST SESSION             ║"
echo "╠══════════════════════════════════════════════╣"
echo "║ Display : $DISPLAY"
echo "║ Screen  : $SCREEN"
echo "║ WM      : NexWM"
echo "╠══════════════════════════════════════════════╣"
echo "║ Close this terminal / press Ctrl+C to quit. ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

exec "$BINDIR/nexwm"
